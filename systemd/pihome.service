[Unit]
Description=Pi Home Control
# Deliberately NOT After=ir-keymap.service/ir-nec.service (measured
# ~248ms + ~199ms serialized on top of pihome.service's own start) — those
# only configure the IR RECEIVER's keymap/protocol for the Learn screen,
# which is several button-presses behind the Menu key and needs a human to
# get there; nothing about booting straight to Active Device Control (IR
# transmit, keypad, LCD) depends on them. They still run — just now in
# parallel with this instead of serialized in front of it. See CLAUDE.md's
# "Pi OS boot time" section.
#
# DefaultDependencies=no (2026-08-31): normal services implicitly wait for
# sysinit.target/basic.target, which pulled in the *entire* local-fs.target
# chain — including boot-firmware.mount and its fsck, ~1.4s+ this service
# has no actual need for (its code/venv live on the already-mounted root
# fs; it never touches /boot/firmware). Measured ~8s of pure wait gated on
# that chain before this service was even allowed to start. GPIO/I2C device
# readiness (the thing that actually matters) comes from systemd-udevd,
# explicitly ordered below, and finishes well before that chain does.
#
# DefaultDependencies=no also drops the automatic Conflicts=/Before=
# shutdown.target every normal service gets — that's what guarantees a
# clean, ordered SIGTERM on shutdown instead of an abrupt kill whenever
# teardown happens to reach this unit. Re-added explicitly below so the
# shutdown-signaling design (see CLAUDE.md's "Shutdown / power-off
# signaling") keeps working exactly as before — only the boot-time wait is
# being dropped, not shutdown ordering.
DefaultDependencies=no
After=systemd-udevd.service
Conflicts=shutdown.target
Before=shutdown.target
# Retry limit for Restart=on-failure below: the app exits nonzero after a
# crash or failed startup (2026-10-18), and a permanent failure (a broken
# config) would otherwise restart forever. 5 starts within 5 minutes, then
# systemd gives up and leaves the last error on the LCD. A rare crash after
# normal use is far outside that window, so it still restarts.
# `sudo systemctl reset-failed pihome.service && sudo systemctl start
# pihome.service` starts it again after fixing the cause.
StartLimitIntervalSec=300
StartLimitBurst=5
# Tried pinning the CPU governor to "performance" via a Wants=/After=
# cpufreq-performance.service pair ahead of this (2026-08-31) on the theory
# that ondemand's ~800-900MHz during the import burst below was costing
# real time. Measured result: consistently ~350-550ms *slower* across two
# reboots — the extra unit's own start + job-scheduling overhead cost more
# than any CPU-speed benefit. Reverted; that service no longer exists.

[Service]
Type=simple
WorkingDirectory=/home/matt/dev/ir

ExecStart=/home/matt/dev/ir/.venv/bin/python3 -u /home/matt/dev/ir/main.py

RestartSec=2
Restart=on-failure

KillSignal=SIGTERM
TimeoutStopSec=5

Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
